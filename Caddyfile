:{$PORT:4173}

encode gzip

# handle /api/* — proxy server-to-server al backend Spring Boot
# Debe ir PRIMERO para que tome precedencia sobre el SPA handler
handle /api/* {
    reverse_proxy https://aetheris-production-3f46.up.railway.app {
        header_up Host aetheris-production-3f46.up.railway.app
        header_up -Origin
    }
}

# handle todo lo demas — SPA React (index.html fallback)
handle {
    root * /app/dist
    try_files {path} /index.html
    file_server
}
